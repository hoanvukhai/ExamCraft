# ==============================================================
# CƠ SỞ DỮ LIỆU & BẢO MẬT HỆ THỐNG
# ==============================================================
# Kết nối PostgreSQL (Docker Compose cổng 5436 hoặc PostgreSQL nội bộ)
DATABASE_URL="postgresql://examcraft:examcraft_secret_2026@localhost:5436/examcraft?schema=public"

# Chuỗi bí mật ký Session Auth
SESSION_SECRET="examcraft_session_super_secret_key_change_in_production_2026"

# Tài khoản khởi tạo ban đầu cho Super Admin
ADMIN_EMAIL="admin@examcraft.local"
ADMIN_INITIAL_PASSWORD="AdminPassword2026@"

# ==============================================================
# QUẢN LÝ GOOGLE GEMINI API KEYS (MÔ HÌNH BYOK - BRING YOUR OWN KEY)
# ==============================================================
# Lưu ý: Hệ thống không lưu trữ API Key chung trong file môi trường.
# Mỗi giáo viên / người dùng tự nhập khóa Gemini cá nhân trực tiếp trên giao diện web.
# Mô hình AI Gemini mặc định (gemini-3.5-flash; kiểm lại với project của bạn)
GEMINI_MODEL="gemini-3.5-flash"

# Máy ít RAM: giới hạn số tiến trình khi build (bỏ trống = mặc định của Next)
# NEXT_BUILD_CPUS=2
