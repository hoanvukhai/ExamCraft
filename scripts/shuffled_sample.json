            "content": "Điểm cực đại là $(0; 2)$.",
            "isCorrect": true
          },
          {
            "key": "c",
            "content": "GTNN trên $[-1; 1]$ bằng $-2$.",
            "isCorrect": true
          },
          {
            "key": "d",
            "content": "Tâm đối xứng là $I(1; 0)$.",
            "isCorrect": true
          }
        ],
        "correct_answer": "a:S, b:Đ, c:Đ, d:Đ",
        "step_by_step_solution": "Mệnh đề a Sai, b Đúng, c Đúng, d Đúng."
      },
